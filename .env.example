# ─────────────────────────────────────────────────────────────────────────────
# AthFuelPath backend — local environment template
#
# Usage:   cp .env.example .env   then fill in the secret values below.
# `api/main.py` calls load_dotenv(), so `.env` is auto-loaded when you run
# `uvicorn api.main:app --reload --port 8000` — no extra step.
#
# `.env` is gitignored. Keep real secrets OUT of this committed template.
# The FEATURE FLAGS below are set to PROD-MATCHING values on purpose, so local
# exercises the same code paths prod does (this is what prevents "works/broken
# locally but the opposite in prod" surprises).
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment (local-only value — do NOT set this to "development" in prod) ─
# Unset defaults to "production" (docs/redoc/openapi disabled — see
# api/main.py::_docs_enabled). Set to "development" locally so /docs stays
# reachable while you're working against this API.
ENVIRONMENT=development

# ── Feature flags (match prod — verified via `fly secrets`) ───────────────────
# Prod has all three of these ON. Leaving them unset/false makes local run a
# DIFFERENT engine than prod (e.g. the legacy clock-based window engine).
EVENT_RELATIVE_WINDOWS=true   # ON in prod -> event-relative window_engine_v2. OFF -> legacy window_templates engine.
FUEL_GAUGE_ENABLED=true       # ON in prod -> fuel-gauge / fueling_targets logic.
COACH_WEB_SEARCH_ENABLED=true # ON in prod -> Nutrition Coach live web search (approved domains only).

# ── Instacart shopping-list handoff (ships dark) ───────────────────────────────
# Off until a real Developer Platform production API key is provisioned. See
# docs/instacart-integration.md for the full setup + rollback procedure.
INSTACART_SHOPPING_LIST_ENABLED=false
INSTACART_ENV=development                # development -> connect.dev.instacart.tools, production -> connect.instacart.com
INSTACART_API_KEY=                       # from dashboard.instacart.com — NEVER paste the real key into source, tickets, chat, or logs
INSTACART_PARTNER_LINKBACK_URL=          # optional — our own URL shown as a "back to AthFuelPath" link on the Instacart page

# ── Local-only behavior flag (intentionally NOT prod's value) ─────────────────
# Prod = false (sends real Web Push). Locally keep it TRUE so testing does not
# fire real notifications to devices. This is a side-effect flag — it does not
# change the windows/labels/UI you're verifying, only whether pushes are sent.
NOTIFICATION_DRY_RUN=true

# ── Secrets — fill in locally; never commit real values ───────────────────────
SECRET_KEY=                   # app secret (session signing)
ANTHROPIC_API_KEY=            # Claude (coach copy generation, claude-sonnet-4-6)
OPENWEATHERMAP_API_KEY=       # weather -> sweat/hydration estimates
FDC_API_KEY=                  # USDA FoodData Central. Key signup: https://fdc.nal.usda.gov/api-key-signup
BRAVE_SEARCH_API_KEY=         # Nutrition Coach knowledge + restaurant-menu web search. Key signup: https://api-dashboard.search.brave.com
FOURSQUARE_API_KEY=           # Nutrition Coach nearby-restaurant discovery. Key signup: https://foursquare.com/developers

# Web Push (VAPID) — only needed if testing real notifications locally
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# Outbound email (dietitian replies / problem reports) — optional locally
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── AWS Bedrock (RAG knowledge base + embeddings) ─────────────────────────────
# Default credential chain: env vars, ~/.aws/credentials, or IAM role on Fly.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=mistral.ministral-3-8b-instruct
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KB_ID=                # Bedrock Knowledge Base id (RAG retrieval)

# ── Database (migration/postgres-cloud-run) ────────────────────────────────────
# PostgreSQL only — DB_PATH/SQLite is no longer read by api/database.py.
#
# LOCAL / CI — set DATABASE_URL (standard libpq connection string or a
# postgres:// URL). Example for a local Postgres instance:
#   DATABASE_URL=postgresql://localhost/athfuelpath_dev
# After setting it, apply the schema once: `python -m db.postgres_migrate`
DATABASE_URL=

# CLOUD RUN — use these instead of DATABASE_URL (DB_PASS comes from Secret
# Manager, never this file). INSTANCE_UNIX_SOCKET is the Cloud SQL Auth Proxy
# socket path Cloud Run mounts automatically when the service is configured
# with a Cloud SQL connection, e.g.:
#   /cloudsql/<project>:<region>:<instance>
DB_USER=
DB_PASS=
DB_NAME=
INSTANCE_UNIX_SOCKET=

# Required by the session-token implementation (api/services/session_auth.py).
# Generate a real random value for any non-local environment — never reuse
# across environments, never commit a real value here.
APP_SESSION_SECRET=

# Fly.io only (single instance) — set to false on Cloud Run, where scheduled
# jobs run via `python -m api.job_runner <job>` triggered by Cloud Run Jobs /
# Cloud Scheduler instead of an in-process APScheduler (see api/job_runner.py
# and api/main.py). Defaults to true (matches current Fly.io behavior) if unset.
IN_PROCESS_SCHEDULER_ENABLED=true
